BEGIN { FS = "\t"; ESC = "\033"; HEXD = "0123456789abcdef"; uinit() }
# Records before the first L line are English (and plain ASCII). An "L xx" block holds language
# xx: only the records and strings that differ, which replace the English ones by index.
$1 == "L" { skip = ($2 != lang); next }
skip { next }
$1 == "S" { S[$2] = $3; next }
$1 == "T" { if ($3 != "") U[$2] = $3; next }
$1 == "N" { i = $2 + 0; if (i > nn) nn = i; NL[i] = $3; NV[i] = $4; next }
$1 == "G" { GT = $2; GW = $3; nw = int(length(GW) / 7); next }
$1 == "I" { ni[$2]++; IW[$2, ni[$2]] = $3; IH[$2, ni[$2]] = $4; IP[$2, ni[$2]] = $5; IC[$2, ni[$2]] = $6; ID[$2, ni[$2]] = $7; next }
$1 == "i" { IC[$2, $3 + 0] = $4; next }
$1 == "Y" { ny++; YY[ny] = $2; YN[ny] = $3; if ($3 > ymax) ymax = $3; next }
$1 == "P" { i = $2 + 0; if (i > np) np = i; PT[i] = $3; PD[i] = $4; PG[i] = $5; PU[i] = $6; PS[i] = $7; PX[i] = $8; PL[i] = $9; next }
$1 == "J" { i = $2 + 0; if (i > nj) nj = i; JR[i] = $3; JC[i] = $4; JW[i] = $5; JP[i] = $6; JF[i] = $7; JB[i] = $8; next }
$1 == "K" { i = $2 + 0; if (i > nk) nk = i; KY[i] = $3; KS[i] = $4; KM[i] = $5; next }
$1 == "E" { i = $2 + 0; if (i > ne) ne = i; ET[i] = $3; ES[i] = $4; EB[i] = $5; next }
$1 == "H" { i = $2 + 0; if (i > nh) nh = i; HL[i] = $3; HN[i] = $4; HU[i] = $5; HX[i] = $6; next }
$1 == "F" { i = $2 + 0; if (i > nf) nf = i; FT[i] = $3; FU[i] = $4; FD[i] = $5; FA[i] = $6; next }
$1 == "M" { k = "m" $2; ni[k] = 1; IW[k, 1] = $3; IH[k, 1] = $4; IP[k, 1] = $5; IE[k, 1] = 1; next }
$1 == "W" { WT[$2] = $3; WL[$2] = $4; if (wfirst == "" || $2 < wfirst) wfirst = $2; next }
$1 == "Q" { nq++; QD[nq] = $2; QL[nq] = $3 + 0; QS[nq] = $4 + 0; next }
$1 == "Z" { nz++; ZI[$2] = nz; ZID[nz] = $2; ZFROM[nz] = $3; ZTO[nz] = $4; ZDAY[nz] = $5; ZRULE[nz] = $6; ZB[nz] = $7 + 0; ZA[nz] = $8 + 0; ZDATE[nz] = $9; ZEF[nz] = $10; ZGR[nz] = $11 + 0; ZLT[nz] = $12 + 0; next }
$1 == "C" { i = $2 + 0; if (i > nc) nc = i; CL[i] = $3; CV[i] = $4; CU[i] = $5; CK[i] = $6; next }

