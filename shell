fi

COLOR=1; [ -n "${NO_COLOR:-}" ] && COLOR=0
VOL=${WEMILLER_VOLUME:-7}
case "$VOL" in [0-9]|10) ;; *) VOL=7 ;; esac

# the query without its last character (which may be several bytes)
drop_last() {
  printf '%s' "$1" | LC_ALL=C awk 'BEGIN { for (i = 1; i < 256; i++) O[sprintf("%c", i)] = i }
    { s = s (NR > 1 ? "\n" : "") $0 }
    END { n = length(s); while (n > 0 && O[substr(s, n, 1)] >= 128 && O[substr(s, n, 1)] < 192) n--; if (n > 0) n--; printf "%s", substr(s, 1, n) }'
}

go() {
  if command -v open >/dev/null 2>&1; then open "$1"
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$1" >/dev/null 2>&1 &
  elif command -v wslview >/dev/null 2>&1; then wslview "$1"
  fi
}

# ---- music: optional, off until you press m ----
MDIR=; MPID=; MSG=
music_off() {
  [ -n "$MPID" ] && kill "$MPID" 2>/dev/null
  MPID=
  if [ -n "$MDIR" ] && [ -d "$MDIR" ] && [ -f "$MDIR/radio" ]; then
    [ -s "$MDIR/pid" ] && kill "$(cat "$MDIR/pid")" 2>/dev/null      # the player: quiet at once
    rm -rf "$MDIR"                             # only ever the temporary folder this script made
  fi
  MDIR=
}
# gain <0-10>: the level as the players take it, 0.00 to 1.00 (a square, as ears hear it)
gain() { printf '%d.%02d' $(($1 * $1 / 100)) $(($1 * $1 % 100)); }
# play <wav> <0-10> <k>: in the background; the player's pid goes in "pid", "end.k" appears when it stops
play() {
  ( case $PLAYER in
      afplay) afplay -v "$(gain "$2")" "$1" & ;;
      pw-play) pw-play --volume="$(gain "$2")" "$1" & ;;
      paplay) paplay --volume=$((65536 * $2 * $2 / 100)) "$1" & ;;
      *) aplay -q "$1" & ;;                     # aplay has no volume: the song is written at the level
    esac
    echo $! >"$MDIR/pid"; wait $!; : >"$MDIR/end.$3" ) >/dev/null 2>&1 &
}
# The radio itself, in the background: compose a song, play it, compose the next while it plays.
# A new volume restarts the player where it was, so every player gets one, even with no volume flag.
radio() {
  trap - EXIT
  KID=
  trap 'kill $KID $(cat "$MDIR/pid" 2>/dev/null) 2>/dev/null; exit 0' TERM HUP
  station=$(( $(date +%s) % 100000 + $$ % 1000 )); k=0; n=0; cur=0
  TICK=1; sleep 0.01 2>/dev/null && TICK=0.25
  # mk <n> <slot> [from sample]: song n as slot.wav (aplay: at today's volume, which goes in slot.v)
  mk() {
    mv=; [ "$PLAYER" = aplay ] && mv=$(cat "$MDIR/vol")
    compose "$station" "$1" "$MDIR/$2.t" "$mv" "${3:-0}" >"$MDIR/$2.pcm" & KID=$!
    wait "$KID" && [ -s "$MDIR/$2.pcm" ] || { echo '%stoppedwhy|could not compose' >"$MDIR/now"; exit 1; }
    { wavhdr $(wc -c <"$MDIR/$2.pcm"); cat "$MDIR/$2.pcm"; } >"$MDIR/$2.wav"; rm -f "$MDIR/$2.pcm"
    echo "$mv" >"$MDIR/$2.v"
  }
  mk 0 s0
  while :; do
    nxt=$((1 - cur))
    [ "$PLAYER" = aplay ] && [ "$(cat "$MDIR/s$cur.v")" != "$(cat "$MDIR/vol")" ] && mk "$n" "s$cur"
    tr -d '\n' <"$MDIR/s$cur.t" >"$MDIR/now"
    vol=$(cat "$MDIR/vol"); k=$((k + 1)); play "$MDIR/s$cur.wav" "$vol" "$k"; t0=$(date +%s); at=0
    mk $((n + 1)) "s$nxt"                      # the next song, while this one plays
    while [ ! -e "$MDIR/end.$k" ]; do
      sleep "$TICK" & KID=$!; wait "$KID"
      v=$(cat "$MDIR/vol" 2>/dev/null) || exit 0
      [ "$v" = "$vol" ] && continue
      at=$((at + ($(date +%s) - t0) * SR)); vol=$v
      kill "$(cat "$MDIR/pid")" 2>/dev/null; while [ ! -e "$MDIR/end.$k" ]; do sleep "$TICK"; done
      if [ "$PLAYER" = aplay ]; then mk "$n" cue "$at"
      else
        skip=$((at * (2 - B8))); left=$(($(wc -c <"$MDIR/s$cur.wav") - 44 - skip))
        [ "$left" -gt 0 ] || break
        { wavhdr "$left"; tail -c +$((45 + skip)) "$MDIR/s$cur.wav"; } >"$MDIR/cue.wav"
      fi
      k=$((k + 1)); play "$MDIR/cue.wav" "$vol" "$k"; t0=$(date +%s)
    done
    rm -f "$MDIR"/end.*; n=$((n + 1)); cur=$nxt
  done
}
music_on() {
  PLAYER=
  for p in afplay pw-play paplay aplay; do     # the ones that come with the system
    if command -v "$p" >/dev/null 2>&1; then PLAYER=$p; break; fi
  done
  [ -n "$PLAYER" ] || { MSG='%noplayer'; return; }
  MDIR=$(mktemp -d 2>/dev/null) || { MDIR=; MSG='%notmp'; return; }
  : >"$MDIR/radio"; echo "$VOL" >"$MDIR/vol"; echo '%tuning' >"$MDIR/now"
  radio </dev/null >/dev/null 2>&1 &
  MPID=$!
  MSG=
}

# ---- dotfiles: D asks first; y installs them for whoever is running this ----
DUSER=$( (id -un 2>/dev/null || echo "${USER:-you}") | tr -cd 'A-Za-z0-9._-')
DFILE=zshlocal                                 # zsh and bash; BusyBox and other plain sh get ashlocal
command -v zsh >/dev/null 2>&1 || command -v bash >/dev/null 2>&1 || DFILE=ashlocal
dot_install() {
  MSG='%dotfail'
  [ -n "${HOME:-}" ] && [ -d "$HOME" ] || return
  dst="$HOME/.$DFILE"; tmp="$dst.new.$$"; src="${WM_ORIGIN:-https://wemiller.com}/dotfiles/$DFILE"
  if command -v curl >/dev/null 2>&1 && curl -fsSL --max-time 30 "$src" -o "$tmp" 2>/dev/null; then :
  elif command -v wget >/dev/null 2>&1 && wget -q -T 30 -O "$tmp" "$src" 2>/dev/null; then :
  else rm -f "$tmp"; return; fi
  # only ever put the real file in place: it names itself on its first line
  case "$(head -n 1 "$tmp" 2>/dev/null)" in "# ~/.$DFILE "*) ;; *) rm -f "$tmp"; return ;; esac
  mv -f "$tmp" "$dst" || { rm -f "$tmp"; return; }
  if [ "$DFILE" = zshlocal ]; then
    line='[ -f ~/.zshlocal ] && source ~/.zshlocal'
    set --
    { command -v zsh >/dev/null 2>&1 || [ -f "$HOME/.zshrc" ]; } && set -- "$@" "$HOME/.zshrc"
    { command -v bash >/dev/null 2>&1 || [ -f "$HOME/.bashrc" ]; } && set -- "$@" "$HOME/.bashrc"
  else
    line='[ -f ~/.ashlocal ] && . ~/.ashlocal'
    set -- "$HOME/.profile"
  fi
  for rc in "$@"; do                           # one line, once
    grep -qF "$line" "$rc" 2>/dev/null || printf '\n%s\n' "$line" >>"$rc" || return
  done
  MSG='%dotok'
}

N1=1; N2=38; N3=4; N4=6; N5=8
# how many entries each section has on the destination day
recount() { set -- $(tui -v want=counts); N2=${1:-$N2}; N3=${2:-$N3}; N4=${3:-$N4}; N5=${4:-$N5}; s1=0; s2=0; s3=0; s4=0; s5=0; }
# The warp to another day: a dozen quick frames, any key skips them. Not on a dumb terminal.
warp() {
  case "${TERM:-}" in dumb|'') return ;; esac
  set -- "$1" $(stty size <"$TTY" 2>/dev/null)
  stty time 1 <"$TTY"
  k=1
  while [ "$k" -le 12 ]; do
    tui -v rows="${2:-24}" -v cols="${3:-80}" -v color="$COLOR" -v utf="$UTF" -v warp="$k" -v wfrom="$1" -v tick="$k"
    W=$(dd bs=1 count=1 2>/dev/null <"$TTY")
    [ -n "$W" ] && break
    k=$((k + 1))
  done
  stty time 2 <"$TTY"
  printf '\033[2J'
}
SAVED=$(stty -g <"$TTY")
DONE=0
cleanup() {
  [ "$DONE" = 1 ] && return
  DONE=1
  music_off
  stty "$SAVED" <"$TTY" 2>/dev/null
  printf '\033[0m\033[?25h\033[?1049l'
  # the verse from the home page on a card (WEMILLER_CARD=0 leaves it out)
  case "${WEMILLER_CARD:-1}" in 0|off|no|false) ;; *) tui -v want=card -v cols="${C:-80}" -v color="$COLOR" -v utf="$UTF"; echo ;; esac
}
trap cleanup EXIT
trap 'exit 0' INT TERM HUP

printf '\033[?1049h\033[?25l\033[2J'
stty -icanon -echo min 0 time 2 <"$TTY"       # a read gives up after 0.2 s: that is the frame clock

tab=1; s1=0; s2=0; s3=0; s4=0; s5=0; tick=0; LR=0; LC=0
mode=0; Q=; ssel=0; NM=0; psel=0; TD=
LEG=full; FR=0; KN=0                           # the legend: in full at first, then condensed
recount
[ -n "$WHEN" ] && warp ""
NL='
'
CR=$(printf '\r'); ESC=$(printf '\033'); TAB=$(printf '\t'); DEL=$(printf '\177'); BS=$(printf '\010')

while :; do
  set -- $(stty size <"$TTY" 2>/dev/null)
  R=${1:-24}; C=${2:-80}
  if [ "$R" != "$LR" ] || [ "$C" != "$LC" ]; then printf '\033[2J'; LR=$R; LC=$C; fi
  eval "sel=\$s$tab; n=\$N$tab"
  NOW=$MSG
  if [ -n "$MPID" ]; then
    if kill -0 "$MPID" 2>/dev/null; then NOW=$(tr -cd ' -~' <"$MDIR/now" 2>/dev/null | cut -c1-48)
    else NOW=$(tr -cd ' -~' <"$MDIR/now" 2>/dev/null | cut -c1-48); MSG=${NOW:-%stopped}; music_off; fi
  fi
  tui -v tab="$tab" -v sel="$sel" -v rows="$R" -v cols="$C" -v tick="$tick" \
    -v color="$COLOR" -v utf="$UTF" -v clock="$(date +%H:%M:%S)" \
    -v mode="$mode" -v q="$Q" -v ssel="$ssel" -v music="$NOW" -v playing="${MPID:+1}" -v vol="$VOL" \
    -v psel="$psel" -v td="$TD" -v lg="$LEG" -v du="$DUSER" -v df="$DFILE"
  K=$(dd bs=1 count=1 2>/dev/null <"$TTY"; printf x); K=${K%x}
  tick=$((tick + 1)); FR=$((FR + 1))
  # the full legend reads for a few seconds or a few keys, then condenses (h brings it back)
  if [ "$LEG" = full ]; then [ -n "$K" ] && KN=$((KN + 1)); { [ "$FR" -ge 30 ] || [ "$KN" -ge 4 ]; } && LEG=short; fi
  [ -z "$K" ] && continue
  if [ "$mode" = 3 ]; then                    # ---- install the dotfiles? only y does ----
    [ "$K" = "$ESC" ] && K=$(dd bs=1 count=2 2>/dev/null <"$TTY"; printf x)   # the rest of an arrow key
    case "$K" in y|Y) dot_install ;; *) MSG='%dotno' ;; esac
    mode=0; continue
  fi
  if [ "$mode" = 2 ]; then                    # ---- the time machine's picker ----
    if [ "$K" = "$ESC" ]; then
      K=$(dd bs=1 count=2 2>/dev/null <"$TTY")
      case "$K" in '[A') psel=$((psel - 1)) ;; '[B') psel=$((psel + 1)) ;; '') mode=0 ;; esac
    else
      case "$K" in
        "$NL"|"$CR")
          P=$(tui -v want=pick -v psel="$psel" -v td="$TD")
          case "$P" in
            '!'*) MSG="%baddate|$TD"; TD= ;;
            *) OLD=${WHEN:-$NOWD}; [ "$P" = - ] && WHEN= || WHEN=$P
               mode=0; TD=; MSG=; recount; warp "$OLD"; tick=0 ;;
          esac ;;
        k) psel=$((psel - 1)) ;;
        j) psel=$((psel + 1)) ;;
        [0-9-]) [ "${#TD}" -lt 10 ] && TD="$TD$K" ;;
        "$DEL"|"$BS") TD=${TD%?} ;;
        q|t) mode=0 ;;
      esac
    fi
    PN=11; [ -n "$WHEN" ] && PN=12
    [ "$psel" -ge "$PN" ] && psel=$((PN - 1))
    [ "$psel" -lt 0 ] && psel=0
    continue
  fi
  if [ "$mode" = 1 ]; then                    # ---- searching ----
    if [ "$K" = "$ESC" ]; then
      K=$(dd bs=1 count=2 2>/dev/null <"$TTY")
      case "$K" in '[A') ssel=$((ssel - 1)) ;; '[B') ssel=$((ssel + 1)) ;; '') mode=0; Q= ;; esac
    else
      case "$K" in
        "$NL"|"$CR")
          set -- $(tui -v want=hit -v q="$Q" -v sel="$ssel")
          if [ $# -eq 2 ] && [ "$1" = 9 ]; then go "$2"; continue; fi   # a photograph: open it, keep searching
          if [ $# -eq 2 ]; then tab=$1; eval "s$tab=$2"; fi
          mode=0; Q=; tick=0; continue ;;
        "$DEL"|"$BS") Q=$(drop_last "$Q"); ssel=0 ;;
        *)                                     # any printable character, in any script
          b=$(printf '%s' "$K" | od -An -tu1 | tr -d ' ')
          if [ "$b" -ge 240 ] 2>/dev/null; then K="$K$(dd bs=1 count=3 2>/dev/null <"$TTY")"
          elif [ "$b" -ge 224 ] 2>/dev/null; then K="$K$(dd bs=1 count=2 2>/dev/null <"$TTY")"
          elif [ "$b" -ge 192 ] 2>/dev/null; then K="$K$(dd bs=1 count=1 2>/dev/null <"$TTY")"
          fi
          if [ "$b" -ge 32 ] 2>/dev/null && [ "$b" != 127 ] && [ "$K" != '\' ] && [ "${#Q}" -lt 60 ]; then Q="$Q$K"; ssel=0; fi ;;
      esac
      NM=$(tui -v want=count -v q="$Q")
    fi
    [ "$ssel" -ge "${NM:-0}" ] && ssel=$((${NM:-0} - 1))
    [ "$ssel" -lt 0 ] && ssel=0
    continue
  fi
  [ -z "$MPID" ] && MSG=                       # a notice lasts until the next key
  if [ "$K" = "$ESC" ]; then
    K=$(dd bs=1 count=2 2>/dev/null <"$TTY")
    case "$K" in '[A') K=k ;; '[B') K=j ;; '[C') K=l ;; '[D') K=left ;; '[5') K=u ;; '[6') K=d ;; '') K=esc ;; *) K= ;; esac
  fi
  case "$K" in
    q|Q) break ;;
    /) mode=1; Q=; ssel=0; NM=0; continue ;;
    r|R)                                       # save the resume as Markdown, never over an existing file
      F="$PWD/Blaine-Miller-Resume.pdf"; n=1
      while [ -e "$F" ]; do n=$((n + 1)); F="$PWD/Blaine-Miller-Resume-$n.pdf"; done
      U="${WM_ORIGIN:-https://wemiller.com}/resume/Blaine-Miller-Resume.pdf"
      if command -v curl >/dev/null 2>&1 && curl -fsSL --max-time 20 "$U" -o "$F" 2>/dev/null; then MSG="%saved|$(basename "$F")|$(basename "$PWD")"
      elif command -v wget >/dev/null 2>&1 && wget -q -T 20 -O "$F" "$U" 2>/dev/null; then MSG="%saved|$(basename "$F")|$(basename "$PWD")"
      else
        [ -f "$F" ] && [ ! -s "$F" ] && rm -f "$F"            # an empty file from a failed download
        F="${F%.pdf}.md"                                      # offline: the same resume as Markdown
        if tui -v want=resume >"$F" 2>/dev/null; then MSG="%offline|$(basename "$F")"; else MSG='%nowrite'; fi
      fi
      continue ;;
    m|M) if [ -n "$MPID" ]; then music_off; MSG=; else music_on; fi; continue ;;
    -|_|+|=)                                   # music volume, 0-10; the music process reads the file
      case "$K" in -|_) [ "$VOL" -gt 0 ] && VOL=$((VOL - 1)) ;; *) [ "$VOL" -lt 10 ] && VOL=$((VOL + 1)) ;; esac
      [ -n "$MDIR" ] && [ -d "$MDIR" ] && echo "$VOL" >"$MDIR/vol"
      [ -z "$MPID" ] && MSG="%vol|$((VOL * 10))"
      continue ;;
    t) mode=2; psel=0; TD=; continue ;;
    T) if [ -n "$WHEN" ]; then OLD=$WHEN; WHEN=; recount; warp "$OLD"; tick=0; fi; continue ;;
    s) if [ "$SEASONS" = 1 ]; then SEASONS=0; MSG='%fxoff'; else SEASONS=1; MSG='%fxon'; fi; continue ;;
    D) mode=3; continue ;;
    L) if [ "$UTF" = 1 ]; then LANGC=$(next_lang "$LANGC"); else MSG='%utf'; fi; tick=0; continue ;;
    k) sel=$((sel - 1)) ;;
    j) sel=$((sel + 1)) ;;
    u) sel=$((sel - 8)) ;;
    d) sel=$((sel + 8)) ;;
    g) sel=0 ;;
    G) sel=$((n - 1)) ;;
    l|"$TAB") tab=$((tab % 5 + 1)); tick=0; continue ;;
    left) tab=$(((tab + 3) % 5 + 1)); tick=0; continue ;;
    h|'?') if [ "$LEG" = help ]; then LEG=short; else LEG=help; fi; continue ;;
    esc) [ "$LEG" = help ] && LEG=short; continue ;;
    1|2|3|4|5) tab=$K; tick=0; continue ;;
    "$NL"|"$CR"|o) U=$(tui -v want=url -v tab="$tab" -v sel="$sel"); [ -n "$U" ] && go "$U" ;;
    *) continue ;;
  esac
  [ "$sel" -ge "$n" ] && sel=$((n - 1))
  [ "$sel" -lt 0 ] && sel=0
  eval "s$tab=$sel"
done
