function bigname(r, c,   F, L, text, row, i, j, ch, line, k, g, n, cur, col) {
  F["B"] = "#### |#   #|#### |#   #|#### "; F["L"] = "#    |#    |#    |#    |#####"
  F["A"] = " ### |#   #|#####|#   #|#   #"; F["I"] = "###| # | # | # |###"
  F["N"] = "#   #|##  #|# # #|#  ##|#   #"; F["E"] = "#####|#    |#### |#    |#####"
  F["M"] = "#   #|## ##|# # #|#   #|#   #"; F["R"] = "#### |#   #|#### |#  # |#   #"
  F["S"] = " ####|#    | ### |    #|#### "; F["O"] = " ### |#   #|#   #|#   #| ### "
  F["T"] = "#####|  #  |  #  |  #  |  #  "; F["D"] = "#### |#   #|#   #|#   #|#### "
  F["C"] = " ####|#    |#    |#    | ####"; F["H"] = "#   #|#   #|#####|#   #|#   #"
  F["G"] = " ####|#    |#  ##|#   #| ####"; F["K"] = "#   #|#  # |###  |#  # |#   #"
  F["P"] = "#### |#   #|#### |#    |#    "; F["U"] = "#   #|#   #|#   #|#   #| ### "
  F["V"] = "#   #|#   #|#   #| # # |  #  "; F["W"] = "#   #|#   #|# # #|## ##|#   #"
  F["Y"] = "#   #| # # |  #  |  #  |  #  "; F["F"] = "#####|#    |#### |#    |#    "
  n = split("27 33 39 45 44 43 49 43 44 45 39 33", g, " ")
  text = BIG != "" ? BIG : S["name_upper"]
  for (row = 1; row <= 5; row++) {
    line = ""
    for (i = 1; i <= length(text); i++) {
      ch = substr(text, i, 1)
      if (ch == " ") { line = line "   "; continue }
      if (!(ch in F)) continue
      split(F[ch], L, "|"); line = line L[row] " "
    }
    o = o at(r + row - 1, c); cur = -1
    for (j = 1; j <= length(line) && j <= cols - c - 1; j++) {
      if (substr(line, j, 1) == "#") {
        col = g[int((j + tick * 2) / 6) % n + 1]
        if (color && col != cur) { o = o ESC "[38;5;" col "m"; cur = col }
        o = o BLK
      } else o = o " "
    }
    o = o RST
  }
  return length(line)
}

function overview(   bw, lx, gl, lt, r, i, x0, xc, h, k, cell, n, big, hdr, eb, bars, need, gap, gw, lv, wk, d, ch, gx) {
  for (r = top; r <= bot; r++) o = o at(r, 2) rep(" ", cols - 2)
  x0 = 4; bars = 3
  big = (cols >= 76 && PH >= 18); hdr = (PH >= 21); eb = (PH >= 23)
  need = (big ? 5 : 1) + 1 + (eb ? 1 : 0) + (hdr ? 1 : 0) + bars + 1 + (nw ? 8 : 0)
  gap = int((PH - need) / 3); if (gap > 2) gap = 2; if (gap < 0) gap = 0
  r = top
  if (big) { bw = bigname(r, x0); motif(r, x0 + bw + 3, r + 4, cols - 3); r += 5 } else { put(r, x0, cols - 6, C_B, S["name"]); r++ }
  if (eb) { put(r, x0, cols - 6, C_DIM, S["eyebrow"]); r++ }
  put(r, x0, cols - 6, C_B, S["tagline"]); r++
  r += gap

  # the numbers, and how many projects each year
  xc = x0 + 46
  if (hdr) {
    put(r, x0, 40, C_AC, U["numbers^"])
    if (cols >= xc + ny * 2) put(r, xc, cols - xc - 1, C_AC, U["byyear^"])
    r++
  }
  for (i = 1; i <= nn; i++) stat(r + int((i - 1) / 2), x0 + ((i - 1) % 2) * 22, NV[i], NL[i])
  if (cols >= xc + ny * 2) {
    for (i = 1; i <= ny; i++) {
      h = int(YN[i] / ymax * bars * 8 + 0.5); if (YN[i] > 0 && h < 1) h = 1; if (h > tick * 3) h = tick * 3
      for (k = 1; k <= bars; k++) {
        cell = h >= k * 8 ? BAR[8] : (h > (k - 1) * 8 ? BAR[h - (k - 1) * 8] : " ")
        o = o at(r + bars - k, xc + (i - 1) * 2) (i == ny ? C_TE : C_AC) cell RST
      }
      if (i % 2 == ny % 2) o = o at(r + bars, xc + (i - 1) * 2) C_DIM substr(YY[i], 3, 2) RST
    }
  }
  r += bars + 1 + gap

  if (GHM == "none" && r + 1 <= bot) { o = o at(r, x0) C_AC "GITHUB" RST C_DIM "  " fit(U["gh.none"], cols - x0 - 12) RST; r += 2 + gap }
  # a year of GitHub, one column per week
  if (nw && r + 7 <= bot) {
    gw = (cols >= x0 + nw * 2 + 4) ? 2 : 1
    gx = x0
    gl = GHM == "past" ? (GT == "" ? U["gh.none"] : fmt(U["contrib.y"], GT, DY)) : GHM == "future" ? U["fut.unwritten"] : fmt(U["contrib"], GT)
    o = o at(r, x0) C_AC "GITHUB" RST C_DIM "  " gl RST
    gx = x0 + 8 + dwidth(gl) + 3
    if (gx + dwidth(U["less"]) + dwidth(U["more"]) + 7 < cols) {
      o = o at(r, gx) C_DIM U["less"] " " RST
      for (lv = 0; lv <= 4; lv++) o = o GC[lv] GCH[lv] RST
      o = o C_DIM " " U["more"] RST
    }
    gx = x0
