    if (pass == 2 && index(tolower(sk), lq) > 0) addhit(3, 0, U["skills"], U["k.work"])
    for (i = 1; i <= nh; i++) {
      inname = index(tolower(HL[i]), lq) > 0; inbody = index(tolower(HX[i]), lq) > 0
      if ((pass == 1 && inname) || (pass == 2 && !inname && inbody)) addhit(4, i - 1, HL[i], U["k.photos"])
    }
    for (i = 1; i <= nc; i++) if (pass == 1 && index(tolower(CL[i] " " CV[i]), lq) > 0) addhit(5, i - 1, CL[i], U["k.contact"])
    if (pass == 2) for (i = 1; i <= nf && nmh < 80; i++) if (index(tolower(FT[i]), lq) > 0) addhit(9, i, FT[i], U["k.photo"])
  }
}
