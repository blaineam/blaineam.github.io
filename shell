lang_of() {
  case "$1" in
    [Zz][Hh]*) echo zh-Hans ;; [Jj][Aa]*) echo ja ;; [Dd][Ee]*) echo de ;; [Ff][Rr]*) echo fr ;;
    [Ee][Ss]*) echo es ;; [Kk][Oo]*) echo ko ;; [Pp][Tt]*) echo pt-BR ;; [Ii][Tt]*) echo it ;;
    [Ee][Nn]*) echo en ;;
