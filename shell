function theme(   i) {
  RST = ESC "[0m"
  if (color) {
    C_FR = ESC "[38;5;60m"; C_AC = ESC "[38;5;75m"; C_TE = ESC "[38;5;79m"; C_DIM = ESC "[38;5;245m"
    C_TX = ESC "[38;5;252m"; C_B = ESC "[1m" ESC "[38;5;255m"; C_SEL = ESC "[48;5;25m" ESC "[38;5;231m" ESC "[1m"
  } else { C_FR = C_AC = C_TE = C_DIM = C_TX = ""; C_B = ESC "[1m"; C_SEL = ESC "[7m" }
  if (SZ && color) C_AC = ESC "[38;5;" ACC "m"   # the season's accent
  NG = split(utf ? "▚ ▞ ▙ ▟ ▛ ▜ ░ ▒ ▓ █ ▄ ▀ ╱ ╲ ┼ ╳" : "# % @ & = + / \\ < > _ ~", GL, " ")
  C_GH = color ? ESC "[38;5;141m" : ""
  if (utf) {
    H = "─"; V = "│"; TL = "╭"; TR = "╮"; BL = "╰"; BR = "╯"; LT = "├"; RT = "┤"; TT = "┬"; BT = "┴"
    BLK = "█"; SHD = "░"; ARROW = "▸"; STAR = "✦"; SCAN = "━"; DOT = "·"
    BAR[1] = "▁"; BAR[2] = "▂"; BAR[3] = "▃"; BAR[4] = "▄"; BAR[5] = "▅"; BAR[6] = "▆"; BAR[7] = "▇"; BAR[8] = "█"
    NOTE = "♪"; VON = "█"; VOFF = "░"
    HK["move"] = "↑↓"; HK["section"] = "←→"
  } else {
    H = "-"; V = "|"; TL = TR = BL = BR = LT = RT = TT = BT = "+"
    BLK = "#"; SHD = "."; ARROW = ">"; STAR = "*"; SCAN = "="; DOT = "-"
    for (i = 1; i <= 8; i++) BAR[i] = i < 5 ? "." : "#"
    NOTE = "~"; VON = "#"; VOFF = "."
    HK["move"] = "^v"; HK["section"] = "<>"
  }
  HK["search"] = "/"; HK["music"] = HK["musicoff"] = "m"; HK["save"] = HK["resume"] = "r"; HK["lang"] = "L"
  HK["open"] = HK["jump"] = "enter"; HK["quit"] = "q"; HK["type"] = ""; HK["cancel"] = "esc"; HK["vol"] = "- +"
  HK["tm"] = "t"; HK["now"] = "T"; HK["fx"] = "s"; HK["dot"] = "D"; HK["date"] = "0-9"; HK["go"] = "enter"; U["h.go"] = U["tm.go"]
  # The key legend: every control, with what it does in words. One line when it fits (with the
  # shorter "resume" label if need be), otherwise as many lines as it takes (up to three); the
  # last line leaves room on its right for the song title or a notice.
  reserve = 0
  if (music != "") reserve = dwidth(msg(music)) + (playing ? dwidth(volbar()) + 2 : 0) + 6
  if (mode == 1) { gap = "   "; hl = "type move jump cancel" }
  else if (mode == 2) { gap = "   "; hl = "date move go cancel" }
  else if (mode == 3) { gap = "   "; hl = "cancel" }
  else { gap = "  "; hl = "move section search " (playing ? "musicoff" : "music") " vol save tm" (travel ? " now" : "") " fx lang dot open quit" }
  HELP = legend(hl, gap); HROWS = 1
  if (dwidth(HELP) > cols - 2 - reserve && mode == 0) { sub(/save/, "resume", hl); HELP = legend(hl, gap) }
  HLN[1] = HELP; HLN[2] = HLN[3] = ""
  if (dwidth(HELP) > cols - 2 - reserve) {
    nh_ = split(hl, HC, " "); HROWS = 1; HLN[1] = ""
    for (i = 1; i <= nh_; i++) {
      t_ = substr(legend(HC[i], gap), 2)
      if (HLN[HROWS] != "" && dwidth(HLN[HROWS]) + length(gap) + dwidth(t_) > cols - 3 && HROWS < 3) HROWS++
      HLN[HROWS] = HLN[HROWS] (HLN[HROWS] == "" ? "" : gap) t_
    }
    for (i = 1; i <= HROWS; i++) HLN[i] = " " HLN[i]
  }
  # After the first moments the legend condenses to one row of keys, with "h help" always there;
  # h (or ?) shows every control with its words, over the screen.
  if (mode == 0 && lg != "full") {
    HROWS = 1; t_ = ""
    split("move section search music vol resume tm" (travel ? " now" : "") " fx lang dot open quit", HC, " ")
    for (i = 1; HC[i] != ""; i++) t_ = t_ " " (HC[i] == "open" ? (utf ? "⏎" : "enter") : HC[i] == "vol" ? "-+" : HK[HC[i]])
    HLN[1] = t_ "   " C_B "h" RST C_DIM " " U["h.help"]
    HLW[1] = dwidth(t_) + 5 + dwidth(U["h.help"])
    HLEN = HLW[1]
  } else {
    for (i = 1; i <= HROWS; i++) { HLN[i] = fit(HLN[i], cols - 2); HLW[i] = TW }
    HLEN = HLW[HROWS]                         # the line the music notice shares
  }
  if (color) { GC[0] = ESC "[38;5;237m"; GC[1] = ESC "[38;5;24m"; GC[2] = ESC "[38;5;31m"; GC[3] = ESC "[38;5;38m"; GC[4] = ESC "[38;5;51m" }
  else GC[0] = GC[1] = GC[2] = GC[3] = GC[4] = ""
  if (utf && color) for (i = 0; i <= 4; i++) GCH[i] = "■"
  else { GCH[0] = "."; GCH[1] = ":"; GCH[2] = "+"; GCH[3] = "*"; GCH[4] = "#" }
}

function chrome(   title, right, i, n, names, plen, r, mid, site, p, w) {
  # the clock, or the time machine's destination day
  title = " " S["name_upper"] " "; right = " " S["langname"] "  " (travel ? (utf ? "◷ " : "@ ") D : clock) " "
  if (dwidth(title) + dwidth(right) > cols - 4) right = " " (travel ? D : clock) " "
  o = o at(1, 1) C_FR TL H RST C_B title RST C_FR rep(H, cols - 4 - dwidth(title) - dwidth(right)) RST (travel ? C_TE : C_AC) right RST C_FR H TR RST
  # the season in the header: a greeting on the day, a little weather either side
  if (SZ) {
    p = 2 + dwidth(title) + 2; w = cols - 2 - dwidth(right) - 2   # the free stretch of the top line
    if (GREET != "" && dwidth(GREET) + 6 <= w - p) {
      r = int((p + w - dwidth(GREET)) / 2)
      o = o at(1, r - 2) C_AC STAR " " C_B GREET RST C_AC " " STAR RST
      motif(1, p, 1, r - 4); motif(1, r + dwidth(GREET) + 3, 1, w)
    } else motif(1, p, 1, w)
  }
  # tabs, long names when they all fit
  w = 0
  for (i = 1; i <= 5; i++) { names[i] = U["t" i "^"]; w += dwidth(names[i]) + 5 }
  if (w > cols - 2) for (i = 1; i <= 5; i++) names[i] = U["s" i "^"]
  n = 5
  o = o at(2, 1) C_FR V RST; plen = 0
  for (i = 1; i <= n; i++) {
    w = dwidth(names[i])
    if (plen + w + 5 > cols - 2) break
    o = o " " (i == tab ? C_SEL " " i " " names[i] " " RST : C_AC " " i RST C_DIM " " names[i] " " RST)
    plen += w + 5
  }
  o = o rep(" ", cols - 2 - plen) C_FR V RST
  mid = wide ? H : TT
  o = o at(3, 1) C_FR LT rep(H, split_col - 2) mid rep(H, cols - split_col - 1) RT RST
  lights(3, 1, cols)
  for (r = top; r <= bot; r++) {
    o = o at(r, 1) C_FR V RST at(r, cols) C_FR V RST
    if (!wide) o = o at(r, split_col) C_FR V RST
  }
  mid = wide ? H : BT
  o = o at(rows - 1 - HROWS, 1) C_FR LT rep(H, split_col - 2) mid rep(H, cols - split_col - 1) RT RST
  for (i = 1; i <= HROWS; i++) o = o at(rows - 1 - HROWS + i, 1) C_FR V RST C_DIM HLN[i] rep(" ", cols - 2 - HLW[i]) RST C_FR V RST
  site = " " S["host"] " "
  o = o at(rows, 1) C_FR BL rep(H, cols - 3 - length(site)) RST C_DIM site RST C_FR H BR RST
  # a light that runs along the bottom edge
  p = 2 + (tick * 2) % (cols - 12 - length(site))
  o = o at(rows, p) C_AC rep(SCAN, 5) RST
}

